# ============================================
# SECURITY NOTICE
# ============================================
# NEVER commit real secrets to version control!
# Generate all secrets using cryptographically secure methods:
#   - Linux/Mac: openssl rand -hex 32
#   - Node.js: require('crypto').randomBytes(32).toString('hex')
# Use a secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.) in production.

# Database
# Use strong, unique passwords for production databases
DATABASE_URL=""

# JWT Configuration
# CRITICAL: Generate unique, cryptographically secure secrets!
# Generate with: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRES_IN="15m"
# Generate with: openssl rand -hex 64
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3001
NODE_ENV=development

# URLs (required in production)
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
BACKEND_URL=http://localhost:3001

# Token Config
TOKEN_PRESALE_PRICE=0.03
TOKEN_SYMBOL=HBCT
TOKEN_NAME="HBC Fire Protection Token"
TOKEN_TOTAL_SUPPLY=250000000

# OAuth - Google
# Get credentials from: https://console.cloud.google.com/apis/credentials
# SECURITY: Never share OAuth secrets. Rotate immediately if exposed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# OAuth - Facebook
# Get credentials from: https://developers.facebook.com/apps/
# SECURITY: Never share OAuth secrets. Rotate immediately if exposed.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3001/api/auth/facebook/callback

# SMTP (for email verification, password reset)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM="HBCT Fire Protection <noreply@example.com>"

# Two-Factor Authentication
# CRITICAL: Generate a secure 32-byte hex key for AES-256 encryption
# Generate with: openssl rand -hex 32
# This key encrypts TOTP secrets. If compromised, regenerate and reset all 2FA.
TWO_FACTOR_ENCRYPTION_KEY=

# ============================================
# BLOCKCHAIN CONFIGURATION
# ============================================

# Network - BSC Mainnet (Chain ID 56)
# For testnet, use CHAIN_ID=97 and testnet RPC URLs
CHAIN_ID=56
BSC_RPC_URL=https://bsc-dataseed1.binance.org
BSC_RPC_URL_FALLBACK=https://bsc-dataseed2.binance.org

# HBCT Token Contract (BSC Mainnet)
HBCT_TOKEN_ADDRESS=
HBCT_DECIMALS=18

# Deposit Configuration
DEPOSIT_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
MIN_CONFIRMATIONS=12
DEPOSIT_POLLING_INTERVAL=15000

# Withdrawal Configuration
# WARNING: Store this securely! Use a secrets manager in production.
WITHDRAWAL_PRIVATE_KEY=
WITHDRAWAL_WALLET_ADDRESS=
MIN_WITHDRAW_AMOUNT=100
MAX_WITHDRAW_AMOUNT=100000
WITHDRAW_FEE_PERCENT=0.1
WITHDRAW_FLAT_FEE=0
WITHDRAWAL_REQUIRES_APPROVAL=true
WITHDRAWAL_APPROVAL_THRESHOLD=10000
WITHDRAWAL_POLLING_INTERVAL=30000
MAX_WITHDRAWAL_RETRIES=3

# Gas Configuration
MAX_GAS_PRICE=10000000000
GAS_LIMIT=100000

# ============================================
# DATABASE RETENTION POLICY
# ============================================
# Automatic cleanup runs daily at 3 AM
# Values are in days - set to 0 to disable cleanup for that table

# Sessions: Clean up expired sessions after X days
RETENTION_SESSIONS_DAYS=7

# Login history: Keep login attempts for X days
RETENTION_LOGIN_HISTORY_DAYS=90

# 2FA audit logs: Keep 2FA events for X days
RETENTION_2FA_AUDIT_DAYS=90

# Notifications: Keep read notifications for X days
RETENTION_NOTIFICATIONS_READ_DAYS=30

# Notifications: Keep unread notifications for X days
RETENTION_NOTIFICATIONS_UNREAD_DAYS=90

# Wallet audit logs: Keep wallet action logs for X days (compliance)
RETENTION_WALLET_AUDIT_DAYS=365

# Withdrawal processing logs: Keep for X days
RETENTION_WITHDRAWAL_LOGS_DAYS=90

# Expired tokens (password reset, email verification): Keep for X days
RETENTION_EXPIRED_TOKENS_DAYS=7

# Processed blockchain events (deduplication): Keep for X days
RETENTION_PROCESSED_EVENTS_DAYS=180
