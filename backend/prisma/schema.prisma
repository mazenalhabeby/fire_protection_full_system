// ============================================
// ACCOUNT DELETION AUDIT LOG
// ============================================

model AccountDeletionLog {
  id                    String    @id @default(cuid())
  userId                String

  // Original user data snapshot (for compliance/audit)
  originalEmail         String
  originalUsername      String?
  originalWalletAddress String?

  // Deletion details
  reason                String    // user_requested, admin_action, fraud, inactive, compliance
  requestedBy           String    // "user" or admin userId
  adminNotes            String?   @db.Text  // Internal notes from admin

  // Financial state at deletion
  availableBalance      Decimal   @db.Decimal(36, 18)
  lockedBalance         Decimal   @db.Decimal(36, 18)
  pendingWithdrawals    Int       @default(0)
  activeLocks           Int       @default(0)

  // Recovery tracking
  gracePeriodEndsAt     DateTime  // 30 days after deletion for recovery
  retentionExpiresAt    DateTime  // 1 year after deletion for permanent purge
  recoveredAt           DateTime?
  recoveredBy           String?   // "user" or admin userId

  // Permanent purge tracking
  permanentlyPurgedAt   DateTime?
  purgeJobId            String?   // Reference to cleanup job

  // Audit trail
  ipAddress             String?
  userAgent             String?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([originalEmail])
  @@index([gracePeriodEndsAt])
  @@index([retentionExpiresAt])
  @@map("account_deletion_logs")
}

// ============================================
// BUYBACK & LIQUIDITY TRACKING
// ============================================

enum BuybackStatus {
  PENDING     // Allocated but not yet executed
  PROCESSING  // Currently executing on-chain
  COMPLETED   // Successfully executed
  FAILED      // Execution failed (can retry)
}

model BuybackAllocation {
  id              String         @id @default(cuid())
  purchaseId      String?        // Related token purchase (if applicable)
  userId          String?        // User whose purchase triggered this

  // Allocation details
  amount          Decimal        @db.Decimal(36, 18)
  currency        String         // BNB, USDT, USDC
  usdValue        Decimal        @db.Decimal(36, 18)

  // Execution status
  status          BuybackStatus  @default(PENDING)
  executedAt      DateTime?
  completedAt     DateTime?
  errorMessage    String?        @db.Text

  // Link to batch execution
  executionId     String?
  execution       BuybackExecution? @relation(fields: [executionId], references: [id])

  // Results (HBCT proportionally assigned from execution)
  swapTxHash      String?        // Same as execution txHash
  liquidityTxHash String?
  hbctBought      Decimal?       @db.Decimal(36, 18)  // Proportional share of HBCT
  liquidityAdded  Decimal?       @db.Decimal(36, 18)

  // Audit
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([purchaseId])
  @@index([userId])
  @@index([currency, status])
  @@index([executionId])
  @@map("buyback_allocations")
}

// Batch execution - ONE BNB swap for multiple allocations
model BuybackExecution {
  id              String         @id @default(cuid())

  // Execution details
  totalBnbSwapped Decimal        @db.Decimal(36, 18)  // Total BNB sent to swap
  totalUsdValue   Decimal        @db.Decimal(36, 18)  // Total USD value of allocations
  totalHbctBought Decimal?       @db.Decimal(36, 18)  // Total HBCT received from swap
  bnbPriceUsd     Decimal        @db.Decimal(18, 8)   // BNB price at execution time

  // Status
  status          BuybackStatus  @default(PENDING)
  swapTxHash      String?        // The single BNB→HBCT transaction
  errorMessage    String?        @db.Text

  // Counts
  allocationCount Int            // Number of allocations in this batch

  // Timestamps
  createdAt       DateTime       @default(now())
  executedAt      DateTime?
  completedAt     DateTime?

  // Related allocations
  allocations     BuybackAllocation[]

  @@index([status, createdAt])
  @@map("buyback_executions")
}
