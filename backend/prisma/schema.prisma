  // Per-transaction limits (in USD)
  minPurchaseUsd    Decimal  @default(10) @db.Decimal(18, 2)
  maxPurchaseUsd    Decimal  @default(10000) @db.Decimal(18, 2)

  // Daily limits (in USD)
