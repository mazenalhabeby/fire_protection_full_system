// HBCT Fire Protection Token Platform - Production Schema
// Version 2.0 - Complete Ecosystem

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  USER
  ADMIN
}

enum TransactionType {
  // New production types
  BUY_WEBSITE
  BUY_DEX
  SELL_DEX
  TRANSFER
  LOCK
  UNLOCK
  REWARD_DISTRIBUTION
  AIRDROP
  AFFILIATE_BONUS
  MARKETPLACE_PURCHASE
  MARKETPLACE_REFUND
  LIQUIDITY_ADD
  FEE_CASHBACK
  // Legacy types (for backward compatibility)
  BUY
  SELL
  STAKE
  UNSTAKE
  REWARD
  REFERRAL_BONUS
}

enum StakeStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum LockStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AirdropStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

// Support System Enums
enum TicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING_REPLY
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketCategory {
  GENERAL
  TECHNICAL
  BILLING
  ACCOUNT
  TOKEN_PURCHASE
  LOCKING
  MARKETPLACE
  AFFILIATE
  OTHER
}

enum SenderType {
  USER
  ADMIN
  SYSTEM
  GUEST
}

// Auth Provider Enum
enum AuthProvider {
  CREDENTIALS
  WALLET
  GOOGLE
  FACEBOOK
}

// ============================================
// WALLET SYSTEM ENUMS
// ============================================

enum Currency {
  HBCT
  BNB
  USDT
  USDC
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAWAL
  INTERNAL_TRANSFER_SEND
  INTERNAL_TRANSFER_RECEIVE
  TOKEN_PURCHASE
  TOKEN_SALE
  LOCK
  UNLOCK
  REWARD
  AIRDROP
  AFFILIATE_COMMISSION
  FEE
  REFUND
  ADMIN_ADJUSTMENT // Admin balance adjustment (can be debit or credit)
}

enum WalletTransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

enum WithdrawalStatus {
  PENDING_CONFIRMATION
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

enum TransferMethod {
  USERNAME
  EMAIL
  WALLET_ADDRESS
  USER_ID
  QR_CODE
}

// Token Purchase System Enums
enum TokenDeliveryMethod {
  OFF_CHAIN    // Store in platform WalletBalance
  ON_CHAIN     // Transfer to linked external wallet
}

enum TokenPurchaseStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// Notification System Enums
enum NotificationType {
  TRANSACTION      // Deposits, withdrawals, purchases, transfers
  SECURITY         // Login alerts, password changes, 2FA
  LOCKING          // Lock created, matured, rewards claimed
  SYSTEM           // Maintenance, updates, announcements
  MARKETING        // Promotions, new features
}

enum NotificationChannel {
  IN_APP
  EMAIL
  BOTH
  NONE
}

// ============================================
// ROLE-BASED ACCESS CONTROL (RBAC)
// ============================================

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isSystem    Boolean  @default(false) // System roles can be modified but marked as default
  isActive    Boolean  @default(true)
  color       String?  // For UI display (e.g., "#7c3aed")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique  // e.g., "users.view", "withdrawals.approve"
  name        String            // e.g., "View Users", "Approve Withdrawals"
  description String?
  module      String            // e.g., "users", "withdrawals", "roles"
  action      String            // e.g., "view", "create", "edit", "delete", "approve"

  createdAt   DateTime @default(now())

  // Relations
  roles       RolePermission[]

  @@unique([module, action])
  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String

  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ============================================
// CORE USER & AUTH
// ============================================

model User {
  id            String       @id @default(cuid())
  email         String?      @unique
  username      String?      @unique  // Unique username for transfers (e.g., john123)
  passwordHash  String?
  firstName     String?
  lastName      String?
  phoneNumber   String?      // User's phone number
  profileImageUrl String?    // URL to user's profile image
  walletAddress String?      @unique
  walletNonce   String?      // Nonce for wallet signature verification
  authProvider  AuthProvider @default(CREDENTIALS)
  legacyRole    UserRole     @default(USER)  // Deprecated: kept for migration

  // RBAC - New role system
  roleId        String?
  adminRole     Role?        @relation(fields: [roleId], references: [id])

  // Email verification
  isEmailVerified Boolean   @default(false)
  emailVerifiedAt DateTime?

  // Account security
  isActive            Boolean   @default(true)
  lastLoginAt         DateTime?
  lastLoginIp         String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Ban status
  isBanned      Boolean   @default(false)
  banReason     String?
  bannedAt      DateTime?

  // Soft delete & Account Deletion
  isDeleted           Boolean   @default(false)
  deletedAt           DateTime?
  originalEmail       String?               // Preserved email before anonymization
  deletionReason      String?               // user_requested, admin_action, fraud, inactive, compliance
  deletionRequestedBy String?               // "user" or admin userId
  retentionExpiresAt  DateTime?             // When data can be permanently purged (1 year)
  canRecover          Boolean   @default(true)  // False after grace period (30 days)

  // Legacy field for backward compatibility
  isVerified    Boolean   @default(false)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Token & Financial Relations
  tokenBalance      TokenBalance?
  transactions      Transaction[]
  tokenSales        TokenSale[]
  locks             TokenLock[]
  rewards           Reward[]

  // Airdrop Relations
  airdropEntries    AirdropEntry[]

  // Marketplace Relations
  marketplaceOrders MarketplaceOrder[]

  // Affiliate Relations
  affiliate         Affiliate?
  referredBy        Affiliate?    @relation("ReferredUsers", fields: [referredById], references: [id])
  referredById      String?
  referralSource    String?       // Source of referral: direct_link, social_share, qr_code, email_campaign, partner
  referralCapturedAt DateTime?    // When the referral code was first captured

  // Legacy Staking (keep for future DeFi)
  stakes            Stake[]

  // Support System Relations
  tickets           SupportTicket[]   @relation("UserTickets")
  assignedTickets   SupportTicket[]   @relation("AssignedTickets")
  ticketMessages    TicketMessage[]

  // NEW: Auth System Relations
  sessions                  Session[]
  passwordResetTokens       PasswordResetToken[]
  emailVerificationTokens   EmailVerificationToken[]
  oauthAccounts             OAuthAccount[]
  loginHistory              LoginHistory[]
  twoFactorAuth             TwoFactorAuth?

  // Multi-wallet support
  wallets                   UserWallet[]

  // Off-chain wallet system
  walletBalances            WalletBalance[]
  walletTransactions        WalletTransaction[]
  sentTransfers             InternalTransfer[]    @relation("SentTransfers")
  receivedTransfers         InternalTransfer[]    @relation("ReceivedTransfers")
  transferLimit             TransferLimit?
  transferQRCodes           TransferQRCode[]
  depositAddresses          DepositAddress[]
  withdrawalRequests        WithdrawalRequest[]
  withdrawalWhitelist       WithdrawalWhitelist[]

  // On-chain deposit/withdrawal system
  onchainDeposits           OnchainDeposit[]
  depositsLockedByMe        OnchainDeposit[]  @relation("DepositLockedBy")
  depositsReleasedByMe      OnchainDeposit[]  @relation("DepositReleasedBy")
  withdrawals               Withdrawal[]

  // Token purchase system
  tokenPurchases            TokenPurchase[]
  purchaseLimits            PurchaseLimits?

  // Notification system
  notifications             Notification[]
  notificationPreference    NotificationPreference?

  // Session activity logging
  sessionActivities         SessionActivity[]

  @@index([roleId])
  @@map("users")
}

// ============================================
// MULTI-WALLET SUPPORT
// ============================================

model UserWallet {
  id              String    @id @default(cuid())
  userId          String
  walletAddress   String    // Normalized to lowercase

  // Wallet metadata
  label           String?   // User-defined label (e.g., "Main Wallet", "Trading")
  isPrimary       Boolean   @default(false)  // Only one can be primary

  // Security & Verification
  verifiedAt      DateTime  // When ownership was verified via signature
  verificationSig String    // The signature used to verify (hashed)
  lastUsedAt      DateTime?

  // Audit trail
  linkedIp        String?   // IP address when wallet was linked
  linkedDevice    String?   // Device info when linked

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([walletAddress])  // One wallet can only be linked to one account
  @@unique([userId, walletAddress])
  @@index([userId, isPrimary])
  @@map("user_wallets")
}

// ============================================
// SESSION MANAGEMENT
// ============================================

model Session {
  id              String    @id @default(cuid())
  userId          String

  // Token tracking
  refreshToken    String    @unique  // Hashed refresh token
  tokenFamily     String    // For refresh token rotation detection

  // Authentication method used for this session
  authMethod      String    @default("password")  // password, google, facebook, wallet

  // Device/Session fingerprinting
  deviceId          String?
  deviceFingerprint String?   // Stable device fingerprint for token binding security
  deviceType        String?   // desktop, mobile, tablet
  deviceName        String?   // "Chrome on Windows", "Safari on iPhone"
  browser           String?
  browserVersion    String?
  os                String?
  osVersion         String?

  // Location tracking (IP-based)
  ipAddress       String?
  previousIpAddress String? // For IP change detection
  country         String?
  city            String?
  latitude        Float?    // For impossible travel detection
  longitude       Float?    // For impossible travel detection

  // Browser geolocation (GPS-based, more accurate)
  browserLatitude   Float?
  browserLongitude  Float?
  browserCity       String?
  browserCountry    String?
  browserAccuracy   Float?    // Accuracy in meters

  // VPN/Proxy detection
  isVpnDetected     Boolean   @default(false)
  vpnDetectedAt     DateTime?
  locationMismatch  Boolean   @default(false)  // IP location differs from GPS location

  // Trusted device feature
  isTrusted       Boolean   @default(false)
  trustedAt       DateTime?
  trustDeviceName String?   // User-friendly name for trusted device

  // Session status
  isValid         Boolean   @default(true)
  revokedAt       DateTime?
  revokedReason   String?   // logout, password_change, security, admin, expired, inactivity, ip_change, suspicious_location

  // Optimistic locking for token refresh race condition prevention
  version         Int       @default(0)

  // Refresh failure tracking for suspicious activity detection
  refreshFailureCount   Int       @default(0)
  lastRefreshFailureAt  DateTime?
  lastRefreshIp         String?   // Last IP that attempted refresh

  // Admin step-up authentication
  adminVerifiedAt       DateTime?  // When admin access was verified via 2FA
  adminVerifiedIp       String?    // IP address when admin was verified
  adminVerifiedUntil    DateTime?  // Admin verification expires (30 min default)

  // Timestamps
  createdAt       DateTime  @default(now())
  lastActivityAt  DateTime  @default(now())
  expiresAt       DateTime

  // Relations
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities SessionActivity[]

  @@index([userId, isValid])
  @@index([refreshToken])
  @@index([tokenFamily])
  @@index([expiresAt])
  @@index([lastActivityAt])
  @@map("sessions")
}

// Session activity logging for security audits
model SessionActivity {
  id          String   @id @default(cuid())
  sessionId   String
  userId      String

  // Activity details
  action      String   // login, logout, password_change, 2fa_setup, withdrawal_request, etc.
  details     String?  // JSON string with additional details
  ipAddress   String?
  userAgent   String?

  // Timestamps
  createdAt   DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@index([createdAt])
  @@map("session_activities")
}

// ============================================
// PASSWORD RESET
// ============================================

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique  // Hashed token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Security tracking
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ============================================
// EMAIL VERIFICATION
// ============================================

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  email     String    // The email being verified
  token     String    @unique  // Hashed token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

// ============================================
// OAUTH ACCOUNTS
// ============================================

model OAuthAccount {
  id                String    @id @default(cuid())
  userId            String
  provider          String    // google, facebook
  providerAccountId String
  email             String?
  name              String?
  avatarUrl         String?
  accessToken       String?   @db.Text  // Encrypted
  refreshToken      String?   @db.Text  // Encrypted
  tokenExpiresAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// ============================================
// LOGIN HISTORY
// ============================================

model LoginHistory {
  id            String   @id @default(cuid())
  userId        String

  // Auth method
  authMethod    String   // credentials, wallet, google, facebook
  success       Boolean
  failureReason String?

  // Device info
  ipAddress     String?
  userAgent     String?
  deviceType    String?
  browser       String?
  os            String?

  // Location
  country       String?
  city          String?

  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_history")
}

// ============================================
// TWO-FACTOR AUTHENTICATION
// ============================================

model TwoFactorAuth {
  id                 String    @id @default(cuid())
  userId             String    @unique

  // TOTP Secret (encrypted at rest using AES-256-GCM)
  encryptedSecret    String    @db.Text
  secretIv           String    // Initialization vector for decryption

  // 2FA State
  isEnabled          Boolean   @default(false)
  enabledAt          DateTime?
  isVerified         Boolean   @default(false) // Must verify TOTP before enabling
  verifiedAt         DateTime?

  // Recovery codes (hashed, comma-separated)
  recoveryCodesHash  String?   @db.Text
  recoveryCodesCount Int       @default(0)

  // Rate limiting for 2FA attempts
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  lastAttemptAt      DateTime?

  // Audit
  lastUsedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_auth")
}

model TwoFactorAuditLog {
  id        String   @id @default(cuid())
  userId    String
  event     String   // setup_initiated, setup_completed, disabled, login_success, login_failed, recovery_code_used, locked
  ipAddress String?
  userAgent String?
  metadata  Json?    // Additional context (recovery code index, failure reason, etc.)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([event, createdAt])
  @@map("two_factor_audit_logs")
}

model TokenBalance {
  id               String   @id @default(cuid())
  userId           String   @unique
  availableBalance Decimal  @default(0) @db.Decimal(36, 18)
  lockedBalance    Decimal  @default(0) @db.Decimal(36, 18)
  totalBalance     Decimal  @default(0) @db.Decimal(36, 18)
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("token_balances")
}

// ============================================
// TRANSACTIONS
// ============================================

model Transaction {
  id               String            @id @default(cuid())
  userId           String?
  type             TransactionType
  amount           Decimal           @db.Decimal(36, 18)
  priceUsd         Decimal?          @db.Decimal(18, 8)
  totalUsd         Decimal?          @db.Decimal(18, 8)
  status           TransactionStatus @default(PENDING)
  txHash           String?
  metadata         Json?
  relatedLockId    String?
  relatedAirdropId String?
  relatedOrderId   String?
  relatedSaleId    String?
  createdAt        DateTime          @default(now())
  completedAt      DateTime?

  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  relatedLock    TokenLock?        @relation(fields: [relatedLockId], references: [id])
  relatedAirdrop AirdropCampaign?  @relation(fields: [relatedAirdropId], references: [id])
  relatedOrder   MarketplaceOrder? @relation(fields: [relatedOrderId], references: [id])
  relatedSale    TokenSale?        @relation(fields: [relatedSaleId], references: [id])
  commissions    Commission[]

  @@index([userId, createdAt])
  @@index([type, status])
  @@map("transactions")
}

// ============================================
// AFFILIATE SYSTEM
// ============================================

model AffiliateTier {
  id              String   @id @default(cuid())
  name            String   @unique
  commissionRate  Decimal  @db.Decimal(5, 4)  // e.g., 0.05 = 5%
  minReferrals    Int      @default(0)        // Min referrals to qualify
  color           String?                     // For UI display
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  affiliates      Affiliate[]

  @@map("affiliate_tiers")
}

model Affiliate {
  id             String   @id @default(cuid())
  userId         String   @unique
  referralCode   String   @unique
  tierId         String?
  commissionRate Decimal  @default(0.05) @db.Decimal(5, 4) // Override or from tier
  totalEarnings  Decimal  @default(0) @db.Decimal(36, 18)
  totalReferrals Int      @default(0)
  totalVolume    Decimal  @default(0) @db.Decimal(36, 18)  // Track referral volume
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tier          AffiliateTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  referredUsers User[]         @relation("ReferredUsers")
  commissions   Commission[]
  tokenSales    TokenSale[]
  auditLogs     AffiliateAuditLog[]

  @@index([tierId])
  @@map("affiliates")
}

model Commission {
  id            String    @id @default(cuid())
  affiliateId   String
  transactionId String
  saleId        String?
  amount        Decimal   @db.Decimal(36, 18)
  isPaid        Boolean   @default(false)
  paidTxHash    String?
  createdAt     DateTime  @default(now())
  paidAt        DateTime?

  affiliate   Affiliate    @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  transaction Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  sale        TokenSale?   @relation(fields: [saleId], references: [id])

  @@index([affiliateId, createdAt])
  @@index([isPaid])
  @@map("commissions")
}

// Affiliate action audit log for security and tracking
model AffiliateAuditLog {
  id          String   @id @default(cuid())
  affiliateId String
  action      String   // REGISTRATION, COMMISSION_CREATED, COMMISSION_CLAIMED, WITHDRAWAL_REQUEST, CODE_VALIDATED
  amount      Decimal? @db.Decimal(36, 18)
  metadata    Json?    // Additional context (IP, user agent, referral details, etc.)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId, createdAt])
  @@index([action])
  @@map("affiliate_audit_logs")
}

// ============================================
// TOKEN LOCKING SYSTEM
// ============================================

model LockTier {
  id                 String   @id @default(cuid())
  name               String
  lockMonths         Int
  bonusPercent       Decimal  @db.Decimal(5, 2)
  feeDiscountPercent Decimal  @db.Decimal(5, 2)
  minAmount          Decimal  @default(0) @db.Decimal(36, 18)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  locks TokenLock[]

  @@map("lock_tiers")
}

model TokenLock {
  id             String     @id @default(cuid())
  userId         String
  lockTierId     String
  amount         Decimal    @db.Decimal(36, 18)
  status         LockStatus @default(ACTIVE)
  startDate      DateTime   @default(now())
  endDate        DateTime
  rewardAmount   Decimal    @default(0) @db.Decimal(36, 18)
  claimedReward  Decimal    @default(0) @db.Decimal(36, 18)
  lockTxHash     String?
  unlockTxHash   String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lockTier     LockTier      @relation(fields: [lockTierId], references: [id])
  rewards      Reward[]
  transactions Transaction[]

  @@index([userId, status])
  @@index([endDate])
  @@map("token_locks")
}

// ============================================
// REWARD POOLS (Ecosystem Tracking)
// ============================================

model RewardPool {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  allocation  Decimal  @db.Decimal(36, 18)
  reserved    Decimal  @default(0) @db.Decimal(36, 18)
  distributed Decimal  @default(0) @db.Decimal(36, 18)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("reward_pools")
}

model Reward {
  id          String    @id @default(cuid())
  userId      String
  lockId      String?
  stakeId     String?
  poolName    String?
  amount      Decimal   @db.Decimal(36, 18)
  isClaimed   Boolean   @default(false)
  claimTxHash String?
  createdAt   DateTime  @default(now())
  claimedAt   DateTime?

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lock  TokenLock? @relation(fields: [lockId], references: [id])
  stake Stake?     @relation(fields: [stakeId], references: [id])

  @@index([userId, isClaimed])
  @@map("rewards")
}

// ============================================
// TOKEN SALES & LIQUIDITY
// ============================================

model TokenSale {
  id              String            @id @default(cuid())
  userId          String?
  affiliateId     String?
  amountHbct      Decimal           @db.Decimal(36, 18)
  priceUsd        Decimal           @db.Decimal(18, 8)
  totalUsd        Decimal           @db.Decimal(18, 8)
  paymentToken    String
  paymentAmount   Decimal           @db.Decimal(36, 18)
  treasuryAmount  Decimal           @db.Decimal(36, 18)
  liquidityAmount Decimal           @db.Decimal(36, 18)
  status          TransactionStatus @default(PENDING)
  saleTxHash      String?
  createdAt       DateTime          @default(now())
  completedAt     DateTime?

  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
