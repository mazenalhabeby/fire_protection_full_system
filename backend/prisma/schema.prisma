  systemChannel        NotificationChannel @default(IN_APP)
  marketingChannel     NotificationChannel @default(NONE)

  // Global settings
  emailEnabled         Boolean             @default(true)
  emailDigest          Boolean             @default(false) // Daily digest instead of instant
  quietHoursEnabled    Boolean             @default(false)
  quietHoursStart      Int?                // Hour (0-23)
  quietHoursEnd        Int?                // Hour (0-23)

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

