// ============================================
// ON-CHAIN DEPOSIT SYSTEM
// ============================================

enum OnchainDepositStatus {
  PENDING          // Transaction detected, awaiting confirmations
  CONFIRMED        // Sufficient confirmations, ready to credit
  CREDITED         // Balance credited to user
  LOCKED           // Mapped by admin but locked for 24h (unverified wallet)
  FAILED           // Failed to process
  UNMAPPED         // No user found for wallet address
}

model OnchainDeposit {
  id             String               @id @default(cuid())
  userId         String?              // Null if unmapped
  txHash         String
  logIndex       Int                  // Log index within transaction
  fromAddress    String               // User's wallet that sent tokens
  toAddress      String               // Platform deposit address
  amount         Decimal              @db.Decimal(36, 18)
  tokenAddress   String               // HBCT contract address
  blockNumber    BigInt
  blockTimestamp DateTime?
  chainId        Int                  @default(56) // BSC mainnet
  status         OnchainDepositStatus @default(PENDING)
  confirmations  Int                  @default(0)
  creditedAt     DateTime?
  failureReason  String?
  metadata       Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  // Lock system fields (for manual mappings from unverified wallets)
  lockedUntil      DateTime?          // When the deposit auto-releases (null = not locked)
  lockedAt         DateTime?          // When the deposit was locked
  lockedByAdminId  String?            // Admin who mapped/locked it
  lockReason       String?            // Why it was locked
  releasedAt       DateTime?          // When it was released (if early)
  releasedByAdminId String?           // Admin who released it early
  walletVerified   Boolean            @default(false) // True if fromAddress matches user's wallet

  user           User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  lockedByAdmin  User? @relation("DepositLockedBy", fields: [lockedByAdminId], references: [id], onDelete: SetNull)
  releasedByAdmin User? @relation("DepositReleasedBy", fields: [releasedByAdminId], references: [id], onDelete: SetNull)

  @@unique([txHash, logIndex])
  @@index([userId, status])
  @@index([fromAddress])
  @@index([status, createdAt])
  @@index([blockNumber])
  @@index([lockedUntil, status]) // For auto-release job
  @@map("onchain_deposits")
}

// Prevent double processing of blockchain events
model ProcessedBlockchainEvent {
  id        String   @id @default(cuid())
  txHash    String
  logIndex  Int
  eventType String   // DEPOSIT, WITHDRAWAL, etc.
  chainId   Int      @default(56)
  createdAt DateTime @default(now())

  @@unique([txHash, logIndex, eventType, chainId])
  @@index([eventType, createdAt])
  @@map("processed_blockchain_events")
}

// ============================================
// ON-CHAIN WITHDRAWAL SYSTEM
// ============================================

enum WithdrawalRequestStatus {
  PENDING_CONFIRMATION  // Awaiting email confirmation
  PENDING_APPROVAL      // Awaiting admin approval (if required)
  APPROVED              // Approved, ready for processing
  PROCESSING            // Being sent on-chain
  COMPLETED             // Successfully sent
  REJECTED              // Rejected by admin
  CANCELLED             // Cancelled by user
  FAILED                // On-chain transaction failed
}

model Withdrawal {
  id                    String                  @id @default(cuid())
  userId                String
  currency              Currency                @default(HBCT)
  amount                Decimal                 @db.Decimal(36, 18)
  feeAmount             Decimal                 @db.Decimal(36, 18)
  netAmount             Decimal                 @db.Decimal(36, 18)
  toAddress             String
  status                WithdrawalRequestStatus @default(PENDING_CONFIRMATION)

  // Confirmation
  confirmationCode      String?
  confirmationExpiresAt DateTime?
  confirmedAt           DateTime?

  // Approval workflow
  requiresApproval      Boolean                 @default(false)
  approvedBy            String?
  approvedAt            DateTime?
  rejectionReason       String?

  // On-chain transaction
  txHash                String?
  gasUsed               BigInt?
  gasPrice              BigInt?
  blockNumber           BigInt?

  // Processing
  processingStartedAt   DateTime?
  retryCount            Int                     @default(0)
  lastError             String?

  // Timestamps
  requestedAt           DateTime                @default(now())
  completedAt           DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([toAddress])
  @@index([txHash])
  @@map("withdrawals")
}

// Track withdrawal processing attempts for debugging
model WithdrawalProcessingLog {
  id           String   @id @default(cuid())
  withdrawalId String
  action       String   // STARTED, TX_SENT, TX_CONFIRMED, FAILED, RETRY
  txHash       String?
  details      Json?
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([withdrawalId, createdAt])
  @@map("withdrawal_processing_logs")
}

// ============================================
// TOKEN PURCHASE SYSTEM
// ============================================

model TokenPurchase {
  id                   String              @id @default(cuid())
  userId               String

  // Payment details
  paymentCurrency      Currency            // BNB, USDT, USDC
  paymentAmount        Decimal             @db.Decimal(36, 18)

  // Token details
  hbctAmount           Decimal             @db.Decimal(36, 18)
  tokenPrice           Decimal             @db.Decimal(18, 8)  // Price at time of purchase

  // Delivery
  deliveryMethod       TokenDeliveryMethod
  destinationWalletId  String?             // UserWallet ID for ON_CHAIN
  destinationAddress   String?             // Wallet address for ON_CHAIN

  // Fees
  platformFee          Decimal             @default(0) @db.Decimal(36, 18)
  networkFee           Decimal?            @db.Decimal(36, 18)  // Only for ON_CHAIN

  // Status tracking
  status               TokenPurchaseStatus @default(PENDING)
  failureReason        String?

  // Blockchain info (for ON_CHAIN only)
  txHash               String?             @unique // Prevent replay attacks - each tx can only be used once

  // Related wallet transactions
  paymentTransactionId String?             // WalletTransaction for payment debit
  creditTransactionId  String?             // WalletTransaction for HBCT credit (OFF_CHAIN only)

  // Affiliate
  affiliateId          String?
  commissionAmount     Decimal?            @db.Decimal(36, 18)

  // Audit
  ipAddress            String?

  // Timestamps
  createdAt            DateTime            @default(now())
  completedAt          DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
  @@index([deliveryMethod, status])
  @@map("token_purchases")
}

model PurchaseLimits {
  id                String   @id @default(cuid())
