# ============================================
# HBCT Fire Protection - Frontend Configuration
# ============================================
# Copy this file to .env.local and fill in your values
#
# IMPORTANT: In production, all NEXT_PUBLIC_* variables are REQUIRED
# The application will fail to build/start without them.

# ===========================================
# REQUIRED VARIABLES
# ===========================================

# Backend API URL (REQUIRED)
# Development: http://localhost:3001/api
# Production: https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# WalletConnect Cloud Project ID (REQUIRED for wallet connections)
# Get your free project ID from: https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# ===========================================
# OPTIONAL VARIABLES
# ===========================================

# HBCT Token Contract Address (BSC Mainnet)
NEXT_PUBLIC_HBCT_TOKEN_ADDRESS=

# Deposit Wallet Address (for displaying to users)
NEXT_PUBLIC_DEPOSIT_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Admin Panel URL (separate admin app)
# Only needed if admin panel is on a different domain
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# Cookie domain for cross-subdomain authentication
# Only needed if frontend and admin are on different subdomains
# Example: .yourdomain.com
# NEXT_PUBLIC_COOKIE_DOMAIN=
# test 